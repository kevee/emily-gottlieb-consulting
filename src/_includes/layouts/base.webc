<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title @text="title || 'Emily Gottlieb Consulting'"></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      webc:keep
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Roboto+Slab&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" webc:keep />
  </head>
  <body>
    <header class="site-header">
      <h1><a href="/">Emily Gottlieb Consulting</a></h1>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>
    <div class="container">
      <template @raw="content" webc:nokeep></template>
    </div>
  </body>
</html>
